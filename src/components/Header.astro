---
import { siteConfig } from '../data/siteConfig';
const { store, navigation } = siteConfig;
---

<!-- Header Wrapper: Fixed overlay with smooth translation for show/hide behavior -->
<div id="header-wrapper" class="fixed top-0 left-0 right-0 z-50 text-cream-50 bg-transparent">
  <!-- Announcement Bar (Desktop) - Directly scrolls away with page scroll -->
  <div id="announcement-bar" class="text-xs px-4 sm:px-6 lg:px-12 border-b border-stone-300/70 hidden md:block bg-[#f1e6cd] text-stone-800 shadow-sm overflow-hidden py-2.5 will-change-transform">
    <div class="max-w-[1560px] mx-auto flex justify-between items-center tracking-widest font-serif-jp text-xs">
      <div class="flex items-center space-x-6">
        <span class="flex items-center gap-1.5 text-stone-800 font-medium">
          <svg class="w-3.5 h-3.5 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          {store.accessList[0]}
        </span>
        <span class="h-3 w-px bg-stone-400/40"></span>
        <span class="flex items-center gap-1.5 text-stone-800 font-medium">
          <svg class="w-3.5 h-3.5 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          営業時間 {store.businessHours}（{store.holidays}定休）
        </span>
      </div>
      <div class="flex items-center space-x-4">
        <a href={`tel:${store.tel.replace(/-/g, '')}`} class="hover:text-gold-600 text-stone-800 font-medium transition-colors flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Tel. {store.tel}
        </a>
        <span class="h-3 w-px bg-stone-400/40"></span>
        <div class="flex items-center space-x-3">
          {store.instagramUrl && (
            <a href={store.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-gold-600 text-stone-800 font-medium transition-colors" aria-label="Instagram">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          )}
          {store.threadsUrl && (
            <a href={store.threadsUrl} target="_blank" rel="noopener noreferrer" class="hover:text-gold-600 text-stone-800 font-medium transition-colors" aria-label="Threads">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.186 24C5.464 24 0 18.536 0 11.814 0 5.092 5.464 0 12.186 0c6.643 0 11.968 5.253 12.014 11.814v.756h-3.952c-.104-4.422-3.69-7.986-8.062-7.986-4.454 0-8.082 3.628-8.082 8.082s3.628 8.082 8.082 8.082c3.551 0 6.646-2.316 7.697-5.698h3.987C20.672 20.373 16.745 24 12.186 24zm-.008-8.793c-1.785 0-3.232-1.447-3.232-3.232s1.447-3.232 3.232-3.232c1.785 0 3.232 1.447 3.232 3.232s-1.447 3.232-3.232 3.232z"/></svg>
            </a>
          )}
          {store.xUrl && (
            <a href={store.xUrl} target="_blank" rel="noopener noreferrer" class="hover:text-gold-600 text-stone-800 font-medium transition-colors" aria-label="X">
              <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <header id="main-header" class="w-full transition-all duration-300 border-b-0">
    <div class="max-w-[1560px] mx-auto px-6 sm:px-8 lg:px-12">
      <div class="flex justify-between items-center h-20">
        <!-- Mobile Left: Menu Toggle Button -->
        <div class="flex items-center lg:hidden w-10">
          <button
            type="button"
            id="mobile-menu-toggle"
            class="p-2 -ml-2 transition-colors focus:outline-none"
            aria-label="メニューを開く"
          >
            <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- Logo: Centered on mobile, Left on desktop -->
        <a href="#" class="group flex items-center focus:outline-none flex-1 lg:flex-initial py-1">
          <div class="px-2.5 py-1 rounded-sm bg-white/90 backdrop-blur-md shadow-xs border border-stone-200/60 flex items-center transition-all duration-300 group-hover:bg-white group-hover:shadow-sm">
            <img
              src={store.logo || "/images/logo.png"}
              alt={store.nameEn}
              class="h-7 sm:h-8 lg:h-9 w-auto max-w-[190px] sm:max-w-[240px] lg:max-w-[280px] object-contain transition-transform duration-300 group-hover:scale-102"
              id="main-logo-img"
            />
          </div>
        </a>

        <!-- Desktop Nav -->
        <nav id="desktop-nav" class="hidden lg:flex items-center space-x-8 text-[13px] font-sans tracking-widest transition-colors">
          {navigation.links.map(link => (
            <a href={link.href} class="hover:text-gold-400 transition-colors uppercase py-1 border-b border-transparent hover:border-gold-400">
              {link.labelEn}
            </a>
          ))}
        </nav>

        <!-- Desktop Right: Contact Action Button -->
        <div class="hidden lg:flex items-center space-x-3">
          <button
            type="button"
            id="contact-btn"
            onclick="openContactModal()"
            class="relative px-5 py-2.5 text-[13px] tracking-widest uppercase border transition-all duration-300 font-medium group backdrop-blur-sm rounded-sm"
          >
            <span class="flex items-center gap-2">
              <span>{navigation.contactBtnText}</span>
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </span>
          </button>
        </div>

        <!-- Mobile Right: Instagram Icon Link -->
        <div class="flex items-center justify-end lg:hidden w-10">
          <a
            href={store.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            id="mobile-instagram-link"
            class="p-2 -mr-2 transition-colors focus:outline-none hover:text-gold-400"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </header>
</div>

<!-- Fullscreen Mobile Menu Overlay (Slides in from Left, Text Fades in) -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[100] bg-[#faf8f5] text-noir-900 flex flex-col justify-between overflow-y-auto px-6 py-5 lg:hidden shadow-2xl"
  style="display: none;"
>
  <!-- Top Bar: Close Left, Logo Center, Instagram Right -->
  <div class="menu-fade-top flex justify-between items-center h-20 flex-shrink-0 max-w-[1560px] mx-auto w-full border-b border-stone-200/60 pb-1">
    <!-- Close Button -->
    <div class="flex items-center w-10">
      <button
        type="button"
        onclick="closeMobileMenu()"
        class="p-2 -ml-2 text-stone-800 hover:text-gold-600 transition-colors focus:outline-none"
        aria-label="メニューを閉じる"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Center Logo -->
    <a href="#" onclick="closeMobileMenu()" class="group flex items-center justify-center focus:outline-none flex-1 px-2">
      <img
        src={store.logo || "/images/logo.png"}
        alt={store.nameEn}
        class="h-7 sm:h-8 w-auto max-w-[200px] object-contain"
      />
    </a>

    <!-- Instagram Icon Link -->
    <div class="flex items-center justify-end w-10">
      <a
        href={store.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 -mr-2 text-stone-800 hover:text-gold-600 transition-colors"
        aria-label="Instagram"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Navigation Links (Left-aligned, Compact vertical spacing) -->
  <nav class="flex-1 flex flex-col items-start justify-center py-5 space-y-2.5 my-auto w-full max-w-sm mx-auto pl-2">
    {navigation.links.map((link, idx) => (
      <a
        href={link.href}
        class="mobile-nav-link menu-fade-item group text-left flex flex-col items-start py-1.5 transition-all duration-300 w-full"
      >
        <span class="font-serif-title tracking-ultra-wide text-xl sm:text-2xl font-light text-stone-900 group-hover:text-gold-600 transition-colors uppercase">
          {link.labelEn}
        </span>
        <span class="text-[11px] text-stone-500 tracking-wider font-serif-jp mt-0.5 group-hover:text-gold-600 transition-colors">
          {link.labelJa}
        </span>
      </a>
    ))}
  </nav>

  <!-- Bottom Action & Contact Info Area -->
  <div class="menu-fade-bottom flex-shrink-0 w-full max-w-sm mx-auto pt-5 pb-4 space-y-3.5 border-t border-stone-300/70 text-center">
    <button
      type="button"
      onclick="openContactModal(); closeMobileMenu();"
      class="w-full py-3.5 bg-noir-900 hover:bg-gold-600 text-cream-50 text-xs font-sans tracking-widest uppercase font-medium transition-colors rounded-sm shadow-sm"
    >
      {navigation.mobileContactBtnText}
    </button>
    <div class="flex items-center justify-center gap-3 text-xs font-serif-jp text-stone-600 pt-1">
      <a href={`tel:${store.tel.replace(/-/g, '')}`} class="hover:text-gold-600 transition-colors text-stone-800 font-medium flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <span>Tel. {store.tel}</span>
      </a>
      <span class="text-stone-400">•</span>
      <span>{store.businessHours}</span>
    </div>
  </div>
</div>

<script is:inline>
  const headerWrapper = document.getElementById('header-wrapper');
  const announcementBar = document.getElementById('announcement-bar');
  const logoTitle = document.getElementById('logo-title');
  const logoSubtitle = document.getElementById('logo-subtitle');
  const desktopNav = document.getElementById('desktop-nav');
  const contactBtn = document.getElementById('contact-btn');
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileInstagram = document.getElementById('mobile-instagram-link');

  let lastScrollY = window.scrollY;
  let isAnnouncementVisible = true;
  let isScrolledTheme = false;

  function setTransparentTheme() {
    if (!isScrolledTheme) return;
    isScrolledTheme = false;

    headerWrapper.classList.add('text-cream-50', 'bg-transparent');
    headerWrapper.classList.remove('text-noir-900', 'bg-cream-50/95', 'backdrop-blur-md', 'shadow-sm');

    logoTitle?.classList.add('text-cream-50');
    logoTitle?.classList.remove('text-noir-900');

    logoSubtitle?.classList.add('text-cream-200');
    logoSubtitle?.classList.remove('text-stone-500');

    desktopNav.classList.add('text-cream-100');
    desktopNav.classList.remove('text-stone-700');

    contactBtn.classList.add('border-white/60', 'text-cream-50', 'hover:bg-cream-50', 'hover:text-noir-900');
    contactBtn.classList.remove('border-stone-800', 'text-noir-900', 'hover:bg-noir-900', 'hover:text-cream-50');

    mobileToggle.classList.add('text-cream-50');
    mobileToggle.classList.remove('text-stone-800');

    if (mobileInstagram) {
      mobileInstagram.classList.add('text-cream-50');
      mobileInstagram.classList.remove('text-stone-800');
    }
  }

  function setSolidScrolledTheme() {
    if (isScrolledTheme) return;
    isScrolledTheme = true;

    headerWrapper.classList.remove('text-cream-50', 'bg-transparent');
    headerWrapper.classList.add('text-noir-900', 'bg-cream-50/95', 'backdrop-blur-md', 'shadow-sm');

    logoTitle?.classList.remove('text-cream-50');
    logoTitle?.classList.add('text-noir-900');

    logoSubtitle?.classList.remove('text-cream-200');
    logoSubtitle?.classList.add('text-stone-500');

    desktopNav.classList.remove('text-cream-100');
    desktopNav.classList.add('text-stone-700');

    contactBtn.classList.remove('border-white/60', 'text-cream-50', 'hover:bg-cream-50', 'hover:text-noir-900');
    contactBtn.classList.add('border-stone-800', 'text-noir-900', 'hover:bg-noir-900', 'hover:text-cream-50');

    mobileToggle.classList.remove('text-cream-50');
    mobileToggle.classList.add('text-stone-800');

    if (mobileInstagram) {
      mobileInstagram.classList.remove('text-cream-50');
      mobileInstagram.classList.add('text-stone-800');
    }
  }

  function handleHeaderScroll() {
    const currentScrollY = window.scrollY;
    const barHeight = announcementBar ? announcementBar.offsetHeight : 0;

    // 1. Top Zone (0px to 140px):
    // The announcement bar slides up strictly with scroll position (natural 1:1 scroll feel)
    if (currentScrollY <= 140) {
      if (announcementBar) {
        // Translate announcement bar smoothly as user scrolls
        const translateY = -Math.min(currentScrollY, barHeight);
        announcementBar.style.transform = `translateY(${translateY}px)`;
      }

      // Main header stays fixed directly below the moving announcement bar
      const headerTranslate = -Math.min(currentScrollY, barHeight);
      headerWrapper.style.transition = 'none';
      headerWrapper.style.transform = `translateY(${headerTranslate}px)`;

      // Transparent theme at the very top
      if (currentScrollY <= 20) {
        setTransparentTheme();
      }
    } else {
      // 2. Below Top Zone (> 140px):
      // Announcement bar is fully out of view
      if (announcementBar) {
        announcementBar.style.transform = `translateY(-${barHeight}px)`;
      }

      headerWrapper.style.transition = 'transform 0.4s ease-out, background-color 0.4s ease-out';

      const isScrollingDown = currentScrollY > lastScrollY + 4;
      const isScrollingUp = currentScrollY < lastScrollY - 4;

      if (isScrollingDown) {
        // Hide entire header when scrolling down
        headerWrapper.style.transform = 'translateY(-100%)';
      } else if (isScrollingUp) {
        // Show navigation menu on scroll up (offset announcement bar so only menu shows)
        headerWrapper.style.transform = `translateY(-${barHeight}px)`;
        setSolidScrolledTheme();
      }
    }

    lastScrollY = Math.max(0, currentScrollY);
  }

  // Initial setup
  isScrolledTheme = true;
  setTransparentTheme();

  window.addEventListener('scroll', handleHeaderScroll, { passive: true });
  handleHeaderScroll();

  // Fullscreen Mobile Menu Controller (Slide-in from left, text fade-in)
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  window.openMobileMenu = function() {
    if (!mobileMenu) return;
    mobileMenu.style.display = 'flex';
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        mobileMenu.classList.add('menu-open');
      });
    });
    document.body.style.overflow = 'hidden';
  };

  window.closeMobileMenu = function() {
    if (!mobileMenu) return;
    mobileMenu.classList.remove('menu-open');
    setTimeout(() => {
      if (!mobileMenu.classList.contains('menu-open')) {
        mobileMenu.style.display = 'none';
      }
    }, 450);
    document.body.style.overflow = '';
  };

  window.toggleMobileMenu = function() {
    if (mobileMenu && mobileMenu.classList.contains('menu-open')) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  };

  toggleBtn?.addEventListener('click', toggleMobileMenu);

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });
</script>

<style>
  /* Fullscreen menu container slide-in from left */
  #mobile-menu {
